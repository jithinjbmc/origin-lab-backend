# Copy this file's contents into Render's Environment Variables settings.
# Never commit a real .env file to GitHub.

# --- GitHub OAuth App (for Decap CMS login) ---
# Create at: https://github.com/settings/developers > New OAuth App
# Homepage URL:      https://www.theoriginlab.in
# Callback URL:      https://YOUR-RENDER-URL.onrender.com/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (contact form) ---
# Use a Gmail App Password, NOT your normal Gmail password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
EMAIL_USER=
EMAIL_PASS=
CONTACT_TO_EMAIL=jithin.j@bharatamatacollege.in

# --- CORS ---
ALLOWED_ORIGIN=https://www.theoriginlab.in
